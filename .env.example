ITDA_NEO_BASE_URL=http://localhost:3002
CUT_EVALUATION_BASE_URL=http://localhost:8000
INTEGRATION_API_SECRET=replace-with-the-itda-neo-integration-secret
STUDIO_LOGIN_PASSWORD_HASH=scrypt:replace-with-generated-salt:replace-with-generated-hash
STUDIO_AUTH_SECRET=replace-with-at-least-32-random-characters

# Supabase server API connection (never use NEXT_PUBLIC_ for the secret).
SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred: sb_secret_...; existing legacy service_role keys also work.
SUPABASE_SECRET_KEY=
# Fixed tenant for the current shared-password login (server only).
STUDIO_WORKSPACE_ID=
STUDIO_OWNER_USER_ID=

# Cloudflare R2 server connection (S3-compatible API).
# Copy the S3 endpoint from R2; do not use a public/custom-domain URL here.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
